NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:8083

# Postgres connection (Postgres.app default: user = your macOS username, no password, port 5432)
DATABASE_URL=postgres://localhost:5432/boafie

# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

# Social sign-in (leave blank to keep a provider disabled)
# GOOGLE_CLIENT_ID is the Web client (used by boafie-web). Google issues a
# separate client id per platform, so the mobile app authenticates with its
# own iOS/Android client ids — all three (when set) are accepted as valid
# token audiences. https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:3001/v1/auth/yahoo/callback
# The boafie-mobile app's registered URL scheme (app.json `expo.scheme`) —
# where the Yahoo callback sends a mobile-initiated sign-in once it's done.
# Only meaningful for a dev-client/standalone build, not Expo Go.
MOBILE_AUTH_CALLBACK_URL=boafie://auth/callback

# --- Deferred integrations (stubbed in this build, wire up when ready) ---
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=
# STRIPE_SECRET_KEY=

# AI bio & proposal drafting (OpenAI) — leave blank to disable
# OPENAI_API_KEY=

# Phone OTP (Hubtel SMS) — leave blank to use the dev stub (fixed code,
# logged server-side instead of sent). Get ClientId/ClientSecret from
# Hubtel > Messaging > Manage > API Keys. HUBTEL_SENDER_ID must be an
# approved Sender ID on your Hubtel account (max 11 chars).
# HUBTEL_CLIENT_ID=
# HUBTEL_CLIENT_SECRET=
# HUBTEL_SENDER_ID=BoaFie

# Email verification codes (Resend) — leave blank to use the dev stub
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=BoaFie <onboarding@resend.dev>

# Where the website's Contact Us form sends messages (also via Resend)
# CONTACT_EMAIL=info.boafietechltd@gmail.com

# File uploads (Cloudinary) — leave blank to disable (uploads will 503
# until set; there is no paste-a-URL fallback for these fields anymore)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
