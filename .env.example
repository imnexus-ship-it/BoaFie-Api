NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Postgres connection (Postgres.app default: user = your macOS username, no password, port 5432)
DATABASE_URL=postgres://localhost:5432/boafie

# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

# Social sign-in (leave blank to keep a provider disabled)
GOOGLE_CLIENT_ID=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:3001/v1/auth/yahoo/callback

# --- Deferred integrations (stubbed in this build, wire up when ready) ---
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=
# STRIPE_SECRET_KEY=

# AI bio & proposal drafting (OpenAI) — leave blank to disable
# OPENAI_API_KEY=

# Phone OTP (Hubtel SMS) — leave blank to use the dev stub (fixed code,
# logged server-side instead of sent). Get ClientId/ClientSecret from
# Hubtel > Messaging > Manage > API Keys. HUBTEL_SENDER_ID must be an
# approved Sender ID on your Hubtel account (max 11 chars).
# HUBTEL_CLIENT_ID=
# HUBTEL_CLIENT_SECRET=
# HUBTEL_SENDER_ID=BoaFie

# Email verification codes (Resend) — leave blank to use the dev stub
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=BoaFie <onboarding@resend.dev>
